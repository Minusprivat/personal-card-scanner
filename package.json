{
  "name": "personal-card-scanner",
  "version": "0.0.1",
  "private": true,
  "description": "Personal Card Scanner via Claude – private Riftbound-Sammlungs-App (PWA)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data:build": "tsx scripts/build-data/index.ts build",
    "data:build:offline": "tsx scripts/build-data/index.ts build --offline",
    "data:report": "tsx scripts/build-data/index.ts report",
    "data:report:offline": "tsx scripts/build-data/index.ts report --offline",
    "icons": "node scripts/make-icons.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "data:samples": "tsx scripts/build-data/index.ts samples",
    "data:images": "tsx scripts/build-data/index.ts images",
    "data:fingerprints": "tsx scripts/build-data/index.ts fingerprints",
    "scan:selftest": "tsx scripts/scan/selftest.ts",
    "scan:scenes": "tsx scripts/scan/scenetest.ts",
    "scan:photos": "tsx scripts/scan/phototest.ts",
    "ocr:copy": "node scripts/copy-ocr.mjs",
    "predev": "node scripts/copy-ocr.mjs",
    "prebuild": "node scripts/copy-ocr.mjs",
    "scan:numbers": "tsx scripts/scan/numbertest.ts"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
